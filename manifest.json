{
  "id": "kitsu.auto.typeset",
  "name": "Kitsu Auto Typeset",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.3.0"
  },
  "manifestVersion": 4,
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "minimumSize": {
        "width": 300,
        "height": 540
      },
      "maximumSize": {
        "width": 600,
        "height": 1288
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 540
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 540
      },
      "label": {
        "default": "Kitsu Auto Typeset"
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icon/icon.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icon/icon.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        }
      ]
    },
    { "type": "command", "id": "reloadPlugin", "label": "Reload Plugin" }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icon/icon.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    }
  ]
}
